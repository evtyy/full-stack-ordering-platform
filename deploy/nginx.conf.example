# Example nginx server block for serving the admin frontend and
# reverse-proxying API/WebSocket traffic to the backend.
# Adjust ports/hosts to match your environment.

pid        /tmp/palette-admin-nginx.pid;
error_log  /tmp/palette-admin-nginx-error.log;

events {
    worker_connections 1024;
}

http {
    access_log /tmp/palette-admin-nginx-access.log;

    # Inlined instead of `include mime.types;` so this config doesn't depend
    # on where your nginx install keeps that file.
    types {
        text/html                             html;
        text/css                              css;
        application/javascript                js;
        application/json                      json map;
        image/png                             png;
        image/x-icon                          ico;
        font/woff                             woff;
        font/ttf                              ttf;
    }
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream backend {
        server 127.0.0.1:8080;
    }

    server {
        # >1024 so it doesn't need sudo/root on macOS/Linux
        listen       8081;
        server_name  localhost;

        # Admin frontend static build
        location / {
            root   admin-frontend;
            index  index.html;
        }

        # Admin API
        location /api/ {
            proxy_pass http://backend/admin/;
        }

        # Customer-facing API
        location /user/ {
            proxy_pass http://backend/user/;
        }

        # WebSocket (order notifications)
        location /ws/ {
            proxy_pass http://backend/ws/;
            proxy_http_version 1.1;
            proxy_read_timeout 3600s;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "$connection_upgrade";
        }
    }
}
